const KEYBOARD_MASK_KEY = 0x00FF;
const KEYBOARD_MASK_EVENT = 0x0100;
const KEYBOARD_EVENT_PRESSED = 0x0100;

const KEY_UP = 1;
const KEY_RIGHT = 2;
const KEY_DOWN = 3;
const KEY_LEFT = 4;
const KEY_ENTER = 10;
const KEY_BACKSPACE = 8;
const KEY_BACKSPACE_ALT = 13;

const KEY_1 = 49;
const KEY_2 = 50;
const KEY_3 = 51;
const KEY_4 = 52;

const KEY_A= 97;
const KEY_D = 100;
const KEY_M = 109;
const KEY_R = 114;
const KEY_S = 115;
const KEY_W = 119;
const KEY_X = 120;
const KEY_Z = 122;

const SCREEN_MODE_ASCII32 = 1;
const SCREEN_WIDTH = 96;
const SCREEN_SIZE = 15360;

const COLOR_WHITE = 0xFF;
const COLOR_YELLOW = 0xFC;
const COLOR_BLACK = 0x00;

// 游戏状态与内存
static board: [u8; 3000] = zeroed;
static stack_x: [u8; 3000] = zeroed;
static stack_y: [u8; 3000] = zeroed;
static stack_ptr: u16 = 0;

// 动态难度配置
static board_w: u16 = 16;
static board_h: u16 = 16;
static total_mines: u16 = 40;

static cursor_x: u16 = 0;
static cursor_y: u16 = 0;
static game_state: u16 = 0; // 0: 游玩中, 1: 胜利, 2: 失败
static cells_revealed: u16 = 0;
static first_click: u16 = 1;
static seed: u32 = 114514;

// 屏幕渲染状态
static screen_cursor: u16 = 0;
static screen_column: u16 = 0;
static text_foreground: u16 = 0xFF;
static text_background: u16 = 0x00;

static draw_x: u16 = 0;
static draw_y: u16 = 0;
static draw_idx: u16 = 0;
static draw_ptr: u16 = 0;

static str_menu: [u8; _] = b"Minesweeper OS\n\nSelect Difficulty:\n1. Beginner (9x9, 10 mines)\n2. Intermediate (16x16, 40 mines)\n3. Expert (30x16, 99 mines)\n4. Custom\n\n> \0";
static str_prompt_w: [u8; _] = b"Width (5-90): \0";
static str_prompt_h: [u8; _] = b"Height (5-30): \0";
static str_prompt_m: [u8; _] = b"Mines: \0";

static str_playing: [u8; _] = b"Playing... (Arrows move, Z reveal, X flag, R restart, M menu)    \0";
static str_won: [u8; _] = b"You Won! Press R to restart, M for menu.                              \0";
static str_lost: [u8; _] = b"You Lost! Press R to restart, M for menu.                             \0";

static framebuffer: [u8; 1] = zeroed;

fn main() -> void {
    screen_buffer(framebuffer);
    screen_mode(SCREEN_MODE_ASCII32);

    // 主循环：菜单 -> 初始化 -> 游玩 -> 返回菜单
    loop {
        show_menu();
        init_game();
        play_game();
    }
}

fn show_menu() -> void {
    clear_screen();
    screen_cursor = framebuffer;
    screen_column = 0;
    text_foreground = COLOR_WHITE;
    text_background = COLOR_BLACK;
    print_string(str_menu);

    let event: u16 = 0;
    let key: u16 = 0;
    let max_m: u16 = 0;

    loop {
        seed = seed + 1; // 在等待菜单输入时持续生成随机种子
        event = keyboard_read();
        key = event & KEYBOARD_MASK_KEY;
        event = event & KEYBOARD_MASK_EVENT;

        if event != KEYBOARD_MASK_EVENT {
            continue;
        }

        if key == KEY_1 {
            board_w = 9; board_h = 9; total_mines = 10; break;
        }
        if key == KEY_2 {
            board_w = 16; board_h = 16; total_mines = 40; break;
        }
        if key == KEY_3 {
            board_w = 30; board_h = 16; total_mines = 99; break;
        }
        if key == KEY_4 {
            newline();
            print_string(str_prompt_w);
            board_w = read_number();
            if board_w > 90 { board_w = 90; }
            if board_w < 5 { board_w = 5; }

            print_string(str_prompt_h);
            board_h = read_number();
            if board_h > 30 { board_h = 30; }
            if board_h < 5 { board_h = 5; }

            print_string(str_prompt_m);
            total_mines = read_number();
            max_m = board_w * board_h;
            max_m = max_m - 1; // 雷数不能等于或超过格子总数
            if total_mines > max_m { total_mines = max_m; }
            if total_mines < 1 { total_mines = 1; }
            break;
        }
    }
}

fn read_number() -> u16 {
    let val: u16 = 0;
    let event: u16 = 0;
    let key: u16 = 0;
    loop {
        seed = seed + 1;
        event = keyboard_read();
        key = event & KEYBOARD_MASK_KEY;
        event = event & KEYBOARD_MASK_EVENT;

        if event != KEYBOARD_MASK_EVENT { continue; }

        if key == KEY_ENTER {
            newline();
            return val;
        }
        
        // 统一退格键处理
        if key == KEY_BACKSPACE { key = KEY_BACKSPACE_ALT; }
        if key == KEY_BACKSPACE_ALT {
            if val > 0 {
                val = val / 10;
                if screen_column > 0 {
                    screen_column = screen_column - 1;
                    screen_cursor = screen_cursor - 4;
                    store8(screen_cursor, 32);
                }
            }
            continue;
        }

        if key >= 48 {
            if key <= 57 {
                val = (val * 10) + (key - 48);
                put_char(key);
            }
        }
    }
}

fn play_game() -> void {
    let event: u16 = 0;
    let key: u16 = 0;
    let max_x: u16 = 0;
    let max_y: u16 = 0;

    loop {
        event = keyboard_read();
        key = event & KEYBOARD_MASK_KEY;
        event = event & KEYBOARD_MASK_EVENT;

        if event != KEYBOARD_MASK_EVENT {
            continue;
        }

        key = to_lower(key);
        max_x = board_w - 1;
        max_y = board_h - 1;

        if game_state == 0 {
            if key == KEY_UP {
                if cursor_y > 0 { cursor_y = cursor_y - 1; }
            }
            if key == KEY_DOWN {
                if cursor_y < max_y { cursor_y = cursor_y + 1; }
            }
            if key == KEY_LEFT {
                if cursor_x > 0 { cursor_x = cursor_x - 1; }
            }
            if key == KEY_RIGHT {
                if cursor_x < max_x { cursor_x = cursor_x + 1; }
            }
            if key == KEY_Z {
                do_reveal(cursor_x, cursor_y);
            }
            if key == KEY_X {
                do_flag(cursor_x, cursor_y);
            }
        }

        if key == KEY_R {
            init_game();
            continue;
        }
        if key == KEY_M {
            return;
        }

        draw_board();
    }
}

fn init_game() -> void {
    let i: u16 = 0;
    let total: u16 = board_w * board_h;
    while i < total {
        store8(board + i, 0);
        i = i + 1;
    }

    cells_revealed = 0;
    game_state = 0;
    cursor_x = 0;
    cursor_y = 0;
    first_click = 1;

    clear_screen();
    draw_board();
}

fn rand() -> u32 {
    let temp1: u32 = 0;
    let temp2: u32 = 0;

    temp1 = seed ^ (seed >> 13);
    temp2 = temp1 ^ (temp1 << 17);
    seed = temp2 ^ (temp2 >> 5);

    return seed;
}

fn place_mines(safe_x: u16, safe_y: u16) -> void {
    let placed: u16 = 0;
    let rx: u16 = 0;
    let ry: u16 = 0;
    let idx: u16 = 0;

    while placed < total_mines {
        rx = rand() % board_w;
        ry = rand() % board_h;

        if rx == safe_x {
            if ry == safe_y {
                continue;
            }
        }

        idx = board + (ry * board_w) + rx;
        if (load8(idx) & 15) != 9 {
            store8(idx, load8(idx) | 9);
            placed = placed + 1;
        }
    }
}

fn calc_numbers() -> void {
    let x: u16 = 0;
    let y: u16 = 0;
    let count: u16 = 0;
    let idx: u16 = 0;

    while y < board_h {
        x = 0;
        while x < board_w {
            idx = board + (y * board_w) + x;
            if (load8(idx) & 15) != 9 {
                count = count_adjacent(x, y);
                store8(idx, (load8(idx) & 48) | count);
            }
            x = x + 1;
        }
        y = y + 1;
    }
}

fn count_adjacent(x: u16, y: u16) -> u16 {
    let count: u16 = 0;
    if is_mine(x - 1, y - 1) == true { count = count + 1; }
    if is_mine(x, y - 1) == true { count = count + 1; }
    if is_mine(x + 1, y - 1) == true { count = count + 1; }
    if is_mine(x - 1, y) == true { count = count + 1; }
    if is_mine(x + 1, y) == true { count = count + 1; }
    if is_mine(x - 1, y + 1) == true { count = count + 1; }
    if is_mine(x, y + 1) == true { count = count + 1; }
    if is_mine(x + 1, y + 1) == true { count = count + 1; }
    return count;
}

fn is_mine(x: u16, y: u16) -> bool {
    if x >= board_w { return false; }
    if y >= board_h { return false; }
    let val: u16 = load8(board + (y * board_w) + x);
    if (val & 15) == 9 {
        return true;
    }
    return false;
}

fn do_reveal(x: u16, y: u16) -> void {
    let idx: u16 = board + (y * board_w) + x;
    let val: u16 = load8(idx);
    let target: u16 = 0;

    if first_click == 1 {
        first_click = 0;
        place_mines(x, y);
        calc_numbers();
        val = load8(idx);
    }

    if (val & 48) != 0 { return; }

    if (val & 15) == 9 {
        game_state = 2;
        reveal_all_mines();
        return;
    }

    stack_ptr = 0;
    store8(idx, (val & 15) | 16);
    cells_revealed = cells_revealed + 1;
    
    if (val & 15) == 0 {
        store8(stack_x, x);
        store8(stack_y, y);
        stack_ptr = 1;
        pop_and_expand();
    }

    // 动态计算胜利条件
    target = board_w * board_h;
    target = target - total_mines;
    if cells_revealed == target {
        game_state = 1;
    }
}

fn try_push(x: u16, y: u16) -> void {
    let idx: u16 = 0;
    let val: u16 = 0;

    if x < board_w {
        if y < board_h {
            idx = board + (y * board_w) + x;
            val = load8(idx);
            
            if (val & 16) == 0 {
                store8(idx, (val & 15) | 16);
                cells_revealed = cells_revealed + 1;
                
                if stack_ptr < 3000 {
                    store8(stack_x + stack_ptr, x);
                    store8(stack_y + stack_ptr, y);
                    stack_ptr = stack_ptr + 1;
                }
            }
        }
    }
}

fn pop_and_expand() -> void {
    let x: u16 = 0;
    let y: u16 = 0;
    let val: u16 = 0;
    let idx: u16 = 0;

    while stack_ptr > 0 {
        stack_ptr = stack_ptr - 1;
        x = load8(stack_x + stack_ptr);
        y = load8(stack_y + stack_ptr);

        idx = board + (y * board_w) + x;
        val = load8(idx);

        if (val & 15) == 0 {
            try_push(x - 1, y - 1);
            try_push(x, y - 1);
            try_push(x + 1, y - 1);
            try_push(x - 1, y);
            try_push(x + 1, y);
            try_push(x - 1, y + 1);
            try_push(x, y + 1);
            try_push(x + 1, y + 1);
        }
    }
}

fn do_flag(x: u16, y: u16) -> void {
    let idx: u16 = board + (y * board_w) + x;
    let val: u16 = load8(idx);

    if first_click == 1 {
        first_click = 0;
        place_mines(x, y);
        calc_numbers();
        val = load8(idx);
    }

    if (val & 16) != 0 { return; }

    store8(idx, val ^ 32);
}

fn reveal_all_mines() -> void {
    let i: u16 = 0;
    let val: u16 = 0;
    let total: u16 = board_w * board_h;
    while i < total {
        val = load8(board + i);
        if (val & 15) == 9 {
            store8(board + i, val | 16);
        }
        i = i + 1;
    }
}

fn draw_board() -> void {
    draw_y = 0;
    while draw_y < board_h {
        draw_x = 0;
        while draw_x < board_w {
            draw_cell();
            draw_x = draw_x + 1;
        }
        draw_y = draw_y + 1;
    }
    draw_status();
}

fn draw_cell() -> void {
    let val: u16 = 0;
    let ch: u16 = 0;
    let fg: u16 = COLOR_WHITE;
    let bg: u16 = COLOR_BLACK;
    let num: u16 = 0;

    draw_idx = board + (draw_y * board_w) + draw_x;
    val = load8(draw_idx);

    if draw_x == cursor_x {
        if draw_y == cursor_y {
            bg = COLOR_YELLOW;
            fg = COLOR_BLACK;
        }
    }

    if (val & 16) != 0 {
        num = val & 15;
        if num == 9 {
            ch = 42; // '*'
        } else {
            if num == 0 {
                ch = 32; // ' '
            } else {
                ch = 48 + num; // '1'-'8'
            }
        }
    } else {
        if (val & 32) != 0 {
            ch = 70; // 'F'
            if bg == COLOR_BLACK {
                fg = COLOR_YELLOW;
            }
        } else {
            ch = 35; // '#'
        }
    }

    // 计算屏幕指针: framebuffer + ((y + 2) * 96 + (x + 2)) * 4
    draw_ptr = draw_y + 2;
    draw_ptr = draw_ptr * 96;
    draw_ptr = draw_ptr + draw_x + 2;
    draw_ptr = draw_ptr << 2;
    draw_ptr = framebuffer + draw_ptr;

    store8(draw_ptr, ch);
    store8(draw_ptr + 1, fg);
    store8(draw_ptr + 2, bg);
    store8(draw_ptr + 3, 0);
}

fn draw_status() -> void {
    // 动态定位到棋盘下方 3 行的位置
    let sy: u16 = board_h + 3;
    screen_cursor = framebuffer + ((sy * 96 + 2) << 2);
    screen_column = 2;
    text_foreground = COLOR_WHITE;
    text_background = COLOR_BLACK;

    if game_state == 0 {
        print_string(str_playing);
    }
    if game_state == 1 {
        print_string(str_won);
    }
    if game_state == 2 {
        print_string(str_lost);
    }
}

fn to_lower(k: u16) -> u16 {
    if k >= 65 {
        if k <= 90 {
            return k + 32;
        }
    }
    return k;
}

fn clear_screen() -> void {
    let cursor: u16 = framebuffer;
    let remaining: u16 = SCREEN_SIZE;
    while remaining != 0 {
        store8(cursor, 0);
        cursor = cursor + 1;
        remaining = remaining - 1;
    }
}

fn print_string(text: u16) -> void {
    let ch: u16 = 0;
    loop {
        ch = load8(text);
        if ch == 0 {
            return;
        }
        if ch == 10 {
            newline();
        } else {
            put_char(ch);
        }
        text = text + 1;
    }
}

fn put_char(ch: u16) -> void {
    store8(screen_cursor, ch);
    store8(screen_cursor + 1, text_foreground);
    store8(screen_cursor + 2, text_background);
    store8(screen_cursor + 3, 0);
    screen_cursor = screen_cursor + 4;
    screen_column = screen_column + 1;
    if screen_column == SCREEN_WIDTH {
        screen_column = 0;
    }
}

fn newline() -> void {
    let rem: u16 = SCREEN_WIDTH - screen_column;
    screen_cursor = screen_cursor + (rem << 2);
    screen_column = 0;
}
