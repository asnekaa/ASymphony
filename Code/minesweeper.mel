const KEYBOARD_MASK_KEY: u16 = 0x00FF;
const KEYBOARD_MASK_EVENT: u16 = 0x0100;
const KEYBOARD_EVENT_PRESSED: u16 = 0x0100;

const KEY_UP: u8 = 1;
const KEY_RIGHT: u8 = 2;
const KEY_DOWN: u8 = 3;
const KEY_LEFT: u8 = 4;
const KEY_A: u8 = 97;
const KEY_D: u8 = 100;
const KEY_R: u8 = 114;
const KEY_S: u8 = 115;
const KEY_W: u8 = 119;
const KEY_X: u8 = 120;
const KEY_Z: u8 = 122;

const SCREEN_MODE_ASCII32: u16 = 1;
const SCREEN_WIDTH: u16 = 96;
const SCREEN_SIZE: u16 = 15360;

const COLOR_WHITE: u8 = 0xFF;
const COLOR_YELLOW: u8 = 0xFC;
const COLOR_BLACK: u8 = 0x00;

// 游戏状态与内存
static board: [u8; 256] = zeroed;
static stack_x: [u8; 256] = zeroed;
static stack_y: [u8; 256] = zeroed;
static stack_ptr: u16 = 0;

static cursor_x: u16 = 0;
static cursor_y: u16 = 0;
static game_state: u8 = 0; // 0: 游玩中, 1: 胜利, 2: 失败
static cells_revealed: u16 = 0;
static first_click: u8 = 1; // 记录是否是第一次点击
static seed: u32 = 114514;

// 屏幕渲染状态
static screen_cursor: u16 = 0;
static screen_column: u16 = 0;
static text_foreground: u8 = 0xFF;
static text_background: u8 = 0x00;

static draw_x: u16 = 0;
static draw_y: u16 = 0;
static draw_idx: u16 = 0;
static draw_ptr: u16 = 0;

// 字符串常量 (长度对齐以覆盖旧文本)
static str_start: [u8; _] = b"Minesweeper\nPress any key to start...\0";
static str_playing: [u8; _] = b"Playing... (UP/RIGHT/DOWN/LEFT move, Z reveal, X flag, R restart)    \0";
static str_won: [u8; _] = b"You Won! Press R to restart.                                   \0";
static str_lost: [u8; _] = b"You Lost! Press R to restart.                                    \0";

static framebuffer: [u8; 1] = zeroed;

fn main() -> void {
    screen_buffer(framebuffer);
    screen_mode(SCREEN_MODE_ASCII32);

    screen_cursor = framebuffer;
    screen_column = 0;
    clear_screen();
    text_foreground = COLOR_WHITE;
    text_background = COLOR_BLACK;
    print_string(str_start);

    let event: u16 = 0;
    let key: u16 = 0;

    // 利用玩家反应时间生成随机种子
    while event != KEYBOARD_MASK_EVENT {
        seed = seed + 1;
        event = keyboard_read();
        event = event & KEYBOARD_MASK_EVENT;
    }

    init_game();

    // 主循环
    loop {
        event = keyboard_read();
        key = event & KEYBOARD_MASK_KEY;
        event = event & KEYBOARD_MASK_EVENT;

        // 仅在按键按下时处理，避免无效重绘
        if event != KEYBOARD_MASK_EVENT {
            continue;
        }

        key = to_lower(key);

        if game_state == 0 {
            if key == KEY_UP {
                if cursor_y > 0 { cursor_y = cursor_y - 1; }
            }
            if key == KEY_DOWN {
                if cursor_y < 15 { cursor_y = cursor_y + 1; }
            }
            if key == KEY_LEFT {
                if cursor_x > 0 { cursor_x = cursor_x - 1; }
            }
            if key == KEY_RIGHT {
                if cursor_x < 15 { cursor_x = cursor_x + 1; }
            }
            if key == KEY_Z {
                do_reveal(cursor_x, cursor_y);
            }
            if key == KEY_X {
                do_flag(cursor_x, cursor_y);
            }
        }

        if key == KEY_R {
            init_game();
        }

        draw_board();
    }
}

fn init_game() -> void {
    let i: u16 = 0;
    while i < 256 {
        store8(board + i, 0);
        i = i + 1;
    }

    cells_revealed = 0;
    game_state = 0;
    cursor_x = 0;
    cursor_y = 0;
    first_click = 1;

    clear_screen();
    draw_board();
}

fn rand() -> u32 {
    let temp1: u32 = 0;
    let temp2: u32 = 0;

    temp1 = seed ^ (seed >> 13);
    temp2 = temp1 ^ (temp1 << 17);
    seed = temp2 ^ (temp2 >> 5);

    return seed;
}

// 仅避开第一次点击的坐标
fn place_mines(safe_x: u16, safe_y: u16) -> void {
    let placed: u16 = 0;
    let rx: u16 = 0;
    let ry: u16 = 0;
    let idx: u16 = 0;

    while placed < 40 {
        rx = rand() % 16;
        ry = rand() % 16;

        // 如果随机到了第一次点击的格子，则跳过
        if rx == safe_x {
            if ry == safe_y {
                continue;
            }
        }

        idx = board + (ry << 4) + rx;
        if (load8(idx) & 15) != 9 {
            store8(idx, load8(idx) | 9);
            placed = placed + 1;
        }
    }
}

fn calc_numbers() -> void {
    let x: u16 = 0;
    let y: u16 = 0;
    let count: u8 = 0;
    let idx: u16 = 0;

    while y < 16 {
        x = 0;
        while x < 16 {
            idx = board + (y << 4) + x;
            if (load8(idx) & 15) != 9 {
                count = count_adjacent(x, y);
                store8(idx, (load8(idx) & 48) | count);
            }
            x = x + 1;
        }
        y = y + 1;
    }
}

fn count_adjacent(x: u16, y: u16) -> u8 {
    let count: u8 = 0;
    if is_mine(x - 1, y - 1) == true { count = count + 1; }
    if is_mine(x, y - 1) == true { count = count + 1; }
    if is_mine(x + 1, y - 1) == true { count = count + 1; }
    if is_mine(x - 1, y) == true { count = count + 1; }
    if is_mine(x + 1, y) == true { count = count + 1; }
    if is_mine(x - 1, y + 1) == true { count = count + 1; }
    if is_mine(x, y + 1) == true { count = count + 1; }
    if is_mine(x + 1, y + 1) == true { count = count + 1; }
    return count;
}

fn is_mine(x: u16, y: u16) -> bool {
    if x >= 16 { return false; }
    if y >= 16 { return false; }
    let val: u8 = load8(board + (y << 4) + x);
    if (val & 15) == 9 {
        return true;
    }
    return false;
}

fn do_reveal(x: u16, y: u16) -> void {
    let idx: u16 = board + (y << 4) + x;
    let val: u8 = load8(idx);

    // 如果是第一次点击，则在此刻生成地雷并计算数字
    if first_click == 1 {
        first_click = 0;
        place_mines(x, y);
        calc_numbers();
        val = load8(idx);
    }

    // 如果已揭开或已插旗，则忽略玩家的手动点击
    if (val & 48) != 0 { return; }

    // 踩到地雷
    if (val & 15) == 9 {
        game_state = 2;
        reveal_all_mines();
        return;
    }

    // 揭开当前单元格并准备泛洪展开
    stack_ptr = 0;
    store8(idx, (val & 15) | 16);
    cells_revealed = cells_revealed + 1;
    
    if (val & 15) == 0 {
        store8(stack_x, x);
        store8(stack_y, y);
        stack_ptr = 1;
        pop_and_expand();
    }

    // 256 - 40 = 216
    if cells_revealed == 216 {
        game_state = 1;
    }
}

fn try_push(x: u16, y: u16) -> void {
    let idx: u16 = 0;
    let val: u8 = 0;

    if x < 16 {
        if y < 16 {
            idx = board + (y << 4) + x;
            val = load8(idx);
            
            // 只要没被揭开就处理（无视旗帜）
            if (val & 16) == 0 {
                // (val & 15) 保留低4位数字，| 16 标记为已揭开
                // 这样操作会自然丢弃掉第5位的旗帜标记（32），实现旗帜消失
                store8(idx, (val & 15) | 16);
                cells_revealed = cells_revealed + 1;
                
                if stack_ptr < 256 {
                    store8(stack_x + stack_ptr, x);
                    store8(stack_y + stack_ptr, y);
                    stack_ptr = stack_ptr + 1;
                }
            }
        }
    }
}

fn pop_and_expand() -> void {
    let x: u16 = 0;
    let y: u16 = 0;
    let val: u8 = 0;
    let idx: u16 = 0;

    while stack_ptr > 0 {
        stack_ptr = stack_ptr - 1;
        x = load8(stack_x + stack_ptr);
        y = load8(stack_y + stack_ptr);

        idx = board + (y << 4) + x;
        val = load8(idx);

        if (val & 15) == 0 {
            try_push(x - 1, y - 1);
            try_push(x, y - 1);
            try_push(x + 1, y - 1);
            try_push(x - 1, y);
            try_push(x + 1, y);
            try_push(x - 1, y + 1);
            try_push(x, y + 1);
            try_push(x + 1, y + 1);
        }
    }
}

fn do_flag(x: u16, y: u16) -> void {
    let idx: u16 = board + (y << 4) + x;
    let val: u8 = load8(idx);

    // 插旗也算作第一次点击，生成地雷
    if first_click == 1 {
        first_click = 0;
        place_mines(x, y);
        calc_numbers();
        val = load8(idx);
    }

    if (val & 16) != 0 { return; } // 已揭开的不能插旗

    store8(idx, val ^ 32); // 异或切换旗帜位
}

fn reveal_all_mines() -> void {
    let i: u16 = 0;
    let val: u8 = 0;
    while i < 256 {
        val = load8(board + i);
        if (val & 15) == 9 {
            store8(board + i, val | 16);
        }
        i = i + 1;
    }
}

fn draw_board() -> void {
    draw_y = 0;
    while draw_y < 16 {
        draw_x = 0;
        while draw_x < 16 {
            draw_cell();
            draw_x = draw_x + 1;
        }
        draw_y = draw_y + 1;
    }
    draw_status();
}

fn draw_cell() -> void {
    let val: u8 = 0;
    let ch: u8 = 0;
    let fg: u8 = COLOR_WHITE;
    let bg: u8 = COLOR_BLACK;
    let num: u8 = 0;

    draw_idx = board + (draw_y << 4) + draw_x;
    val = load8(draw_idx);

    if draw_x == cursor_x {
        if draw_y == cursor_y {
            bg = COLOR_YELLOW;
            fg = COLOR_BLACK;
        }
    }

    if (val & 16) != 0 {
        num = val & 15;
        if num == 9 {
            ch = 42; // '*'
        } else {
            if num == 0 {
                ch = 32; // ' '
            } else {
                ch = 48 + num; // '1'-'8'
            }
        }
    } else {
        if (val & 32) != 0 {
            ch = 70; // 'F'
            if bg == COLOR_BLACK {
                fg = COLOR_YELLOW;
            }
        } else {
            ch = 35; // '#'
        }
    }

    // 计算屏幕指针: framebuffer + ((y + 2) * 96 + (x + 2)) * 4
    draw_ptr = draw_y + 2;
    draw_ptr = draw_ptr * 96;
    draw_ptr = draw_ptr + draw_x + 2;
    draw_ptr = draw_ptr << 2;
    draw_ptr = framebuffer + draw_ptr;

    store8(draw_ptr, ch);
    store8(draw_ptr + 1, fg);
    store8(draw_ptr + 2, bg);
    store8(draw_ptr + 3, 0);
}

fn draw_status() -> void {
    // 定位到第 20 行，第 2 列
    screen_cursor = framebuffer + 7688; 
    screen_column = 2;
    text_foreground = COLOR_WHITE;
    text_background = COLOR_BLACK;

    if game_state == 0 {
        print_string(str_playing);
    }
    if game_state == 1 {
        print_string(str_won);
    }
    if game_state == 2 {
        print_string(str_lost);
    }
}

fn to_lower(k: u16) -> u16 {
    if k >= 65 {
        if k <= 90 {
            return k + 32;
        }
    }
    return k;
}

fn clear_screen() -> void {
    let cursor: u16 = framebuffer;
    let remaining: u16 = SCREEN_SIZE;
    while remaining != 0 {
        store8(cursor, 0);
        cursor = cursor + 1;
        remaining = remaining - 1;
    }
}

fn print_string(text: u16) -> void {
    let ch: u8 = 0;
    loop {
        ch = load8(text);
        if ch == 0 {
            return;
        }
        if ch == 10 {
            newline();
        } else {
            put_char(ch);
        }
        text = text + 1;
    }
}

fn put_char(ch: u8) -> void {
    store8(screen_cursor, ch);
    store8(screen_cursor + 1, text_foreground);
    store8(screen_cursor + 2, text_background);
    store8(screen_cursor + 3, 0);
    screen_cursor = screen_cursor + 4;
    screen_column = screen_column + 1;
    if screen_column == SCREEN_WIDTH {
        screen_column = 0;
    }
}

fn newline() -> void {
    let rem: u16 = SCREEN_WIDTH - screen_column;
    screen_cursor = screen_cursor + (rem << 2);
    screen_column = 0;
}