xor %a(register), %b(register), %c(register)
00010100 aaaabbbb 0000cccc 00000000
# 对寄存器 %b 和寄存器 %c 的值执行按位异或运算，并将结果存入寄存器 %a 。

xor %a(register), %b(register), %c:U16(immediate | label)
01010100 aaaabbbb cccccccc cccccccc
# 对寄存器 %b 的值和固定值 %c 执行按位异或运算，并将结果存入寄存器 %a 。

lsl %a(register), %b(register), %c(register)
00010101 aaaabbbb 0000cccc 00000000
# 将寄存器 %c 的值作为位移量，对寄存器 %b 的值执行逻辑左移，并将结果存入寄存器 %a 。

lsl %a(register), %b(register), %c:U16(immediate | label)
