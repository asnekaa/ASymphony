[settings]
name = "ASymphony"

[fields]

register
zr 0000
r1 0001
r2 0010
r3 0011
r4 0100
r5 0101
r6 0110
r7 0111
r8 1000
r9 1001
r10 1010
r11 1011
r12 1100
r13 1101
sp 1110
lr 1111

[instructions]

nop
00000000 00000000 00000000 00000000
# 不执行任何操作。


keyboard %a(register)
00000001 aaaa0000 00000000 00000000
# 读取一个键盘输入值并将其存入寄存器 %a 。

screen %a(register), %b(register)
00000010 0000aaaa 0000bbbb 00000000
# 将寄存器 %b 的值写入显示屏的选项寄存器 %a  。

screen %a(register), %b:U16(immediate)
01000010 0000aaaa bbbbbbbb bbbbbbbb
# 将立即数 %b 写入显示屏的选项寄存器 %a 。

time_0 %a(register)
00000011 aaaa0000 00000000 00000000
# 将系统时间的低 32 位数值写入寄存器 %a 。

time_1 %a(register)
00000100 aaaa0000 00000000 00000000
# 将系统时间的高 32 位数值写入寄存器 %a 。

counter %a(register)
00000101 aaaa0000 00000000 00000000
# 将程序计数器的值写入寄存器 %a 。


nand %a(register), %b(register), %c(register)
00010000 aaaabbbb 0000cccc 00000000
# 对寄存器 %b 和寄存器 %c 的值执行按位与非运算，并将结果存入寄存器 %a 。

nand %a(register), %b(register), %c:U16(immediate | label)
01010000 aaaabbbb cccccccc cccccccc
# 对寄存器 %b 的值和固定值 %c 执行按位与非运算，并将结果存入寄存器 %a 。

or %a(register), %b(register), %c(register)
