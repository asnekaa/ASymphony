div %a(register), %b(register), %c:U16(immediate | label)
01011011 aaaabbbb cccccccc cccccccc
# 将寄存器 %b 的值和固定值 %c 相除，并将结果存入寄存器 %a 。

mod %a(register), %b(register), %c(register)
00011100 aaaabbbb 0000cccc 00000000
# 将寄存器 %b 和寄存器 %c 的值相余，并将结果存入寄存器 %a 。

mod %a(register), %b(register), %c:U16(immediate | label)
01011100 aaaabbbb cccccccc cccccccc
# 将寄存器 %b 的值和固定值 %c 相余，并将结果存入寄存器 %a 。


jmp %a(register)
00100000 00000000 0000aaaa 00000000
# 令程序跳转至寄存器 %a 指定的地址。

jmp.c %a(register)
10100000 00000000 0000aaaa 00000000
# 若条件寄存器为1，则令程序跳转至寄存器 %a 指定的地址。

jmp %a:U16(immediate | label)
01100000 00000000 aaaaaaaa aaaaaaaa
# 令程序跳转至地址 %a 。

jmp.c %a:U16(immediate | label)
11100000 00000000 aaaaaaaa aaaaaaaa
# 若条件寄存器为1，则令程序跳转至地址 %a 。

eq %a(register), %b(register)
00100001 0000aaaa 0000bbbb 00000000
# 比较寄存器 %a 和寄存器 %b 中的值，若相等，则将条件寄存器置为 1，否则置为 0。

eq %a(register), %b:U16(immediate)
01100001 0000aaaa bbbbbbbb bbbbbbbb
# 比较寄存器 %a 的值和立即数 %b ，若相等，则将条件寄存器置为 1，否则置为 0。

ne %a(register), %b(register)
00100010 0000aaaa 0000bbbb 00000000
