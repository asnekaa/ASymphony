add %a(register), %b(register), %c:U16(immediate | label)
01011000 aaaabbbb cccccccc cccccccc
# 将寄存器 %b 的值和固定值 %c 相加，并将结果存入寄存器 %a 。

sub %a(register), %b(register), %c(register)
