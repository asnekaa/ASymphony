const SCREEN_MODE_PIXEL32: u16 = 3;
const RESOLUTION_SETTING: u16 = 31;
const SCREEN_WIDTH: u16 = 128;
const SCREEN_HEIGHT: u16 = 96;
const SCREEN_BYTES: u16 = 49152;
const CENTER_X: u16 = 64;
const CENTER_Y: u16 = 48;
const UTC8_OFFSET: u32 = 28800;
const SECONDS_PER_DAY: u32 = 86400;
const NANOSECONDS_PER_SECOND: u32 = 1000000000;

static division_remainder: u32 = 0;
static nanoseconds_remainder: u32 = 0;
static time_high_word: u32 = 0;
static time_low_word: u32 = 0;

static color_r: u8 = 0;
static color_g: u8 = 0;
static color_b: u8 = 0;

static line_x: u32 = 0;
static line_y: u32 = 0;
static line_x1: u32 = 0;
static line_y1: u32 = 0;
static line_dx: u32 = 0;
static line_dy: u32 = 0;
static line_sx: u32 = 0;
static line_sy: u32 = 0;
static line_error: u32 = 0;
static line_error2: u32 = 0;

static hour_x: [u8; 60] = [64, 66, 68, 70, 71, 73, 75, 76, 77, 79, 80, 80, 81, 82, 82, 82, 82, 82, 81, 80, 80, 79, 77, 76, 75, 73, 71, 70, 68, 66, 64, 62, 60, 58, 57, 55, 53, 52, 51, 49, 48, 48, 47, 46, 46, 46, 46, 46, 47, 48, 48, 49, 51, 52, 53, 55, 57, 58, 60, 62];
static hour_y: [u8; 60] = [30, 30, 30, 31, 32, 32, 33, 35, 36, 37, 39, 41, 42, 44, 46, 48, 50, 52, 54, 55, 57, 59, 60, 61, 63, 64, 64, 65, 66, 66, 66, 66, 66, 65, 64, 64, 63, 61, 60, 59, 57, 55, 54, 52, 50, 48, 46, 44, 42, 41, 39, 37, 36, 35, 33, 32, 32, 31, 30, 30];
static minute_x: [u8; 60] = [64, 67, 70, 73, 75, 78, 80, 83, 85, 87, 88, 90, 91, 91, 92, 92, 92, 91, 91, 90, 88, 87, 85, 83, 80, 78, 75, 73, 70, 67, 64, 61, 58, 55, 53, 50, 48, 45, 43, 41, 40, 38, 37, 37, 36, 36, 36, 37, 37, 38, 40, 41, 43, 45, 48, 50, 53, 55, 58, 61];
static minute_y: [u8; 60] = [20, 20, 21, 21, 22, 24, 25, 27, 29, 32, 34, 37, 39, 42, 45, 48, 51, 54, 57, 59, 62, 64, 67, 69, 71, 72, 74, 75, 75, 76, 76, 76, 75, 75, 74, 72, 71, 69, 67, 64, 62, 59, 57, 54, 51, 48, 45, 42, 39, 37, 34, 32, 29, 27, 25, 24, 22, 21, 21, 20];
static second_x: [u8; 60] = [64, 68, 71, 75, 78, 81, 84, 87, 89, 92, 93, 95, 96, 97, 98, 98, 98, 97, 96, 95, 93, 92, 89, 87, 84, 81, 78, 75, 71, 68, 64, 60, 57, 53, 50, 47, 44, 41, 39, 36, 35, 33, 32, 31, 30, 30, 30, 31, 32, 33, 35, 36, 39, 41, 44, 47, 50, 53, 57, 60];
static second_y: [u8; 60] = [14, 14, 15, 16, 17, 19, 20, 23, 25, 28, 31, 34, 37, 41, 44, 48, 52, 55, 59, 62, 65, 68, 71, 73, 76, 77, 79, 80, 81, 82, 82, 82, 81, 80, 79, 77, 76, 73, 71, 68, 65, 62, 59, 55, 52, 48, 44, 41, 37, 34, 31, 28, 25, 23, 20, 19, 17, 16, 15, 14];
static tick_inner_x: [u8; 12] = [64, 82, 94, 99, 94, 82, 64, 47, 34, 29, 34, 46];
static tick_inner_y: [u8; 12] = [13, 18, 30, 48, 66, 78, 83, 78, 66, 48, 30, 18];
static tick_outer_x: [u8; 12] = [64, 84, 99, 104, 99, 84, 64, 44, 29, 24, 29, 44];
static tick_outer_y: [u8; 12] = [8, 13, 28, 48, 68, 83, 88, 83, 68, 48, 28, 13];

static framebuffer: [u8; 1] = zeroed;

fn main() -> void {
    stack_set(0xFF00);
    clear_buffer(framebuffer, SCREEN_BYTES);
    draw_face();

    let timestamp: u32 = 0;
    let deadline_low: u32 = 0;
    let hour: u8 = 0;
    let minute: u8 = 0;
    let second: u8 = 0;
    let current_low: u32 = 0;

    time_snapshot(time_high_word, time_low_word);
    timestamp = nanoseconds_to_seconds(time_high_word, time_low_word);
    deadline_low = time_low_word + (NANOSECONDS_PER_SECOND - nanoseconds_remainder);

    udiv32(timestamp + UTC8_OFFSET, SECONDS_PER_DAY);
    timestamp = division_remainder;
    hour = udiv32(timestamp, 3600);
    timestamp = division_remainder;
    minute = udiv32(timestamp, 60);
    second = division_remainder;

    draw_hands(hour, minute, second, false);

    screen_mode(SCREEN_MODE_PIXEL32);
    screen_buffer(framebuffer);
    screen_resolution(RESOLUTION_SETTING);

    loop {
        current_low = time_low();
        if (current_low - deadline_low) >= 0 {
            deadline_low = deadline_low + NANOSECONDS_PER_SECOND;

            draw_hands(hour, minute, second, true);

            second = second + 1;
            if second == 60 {
                second = 0;
                minute = minute + 1;
                if minute == 60 {
                    minute = 0;
                    hour = hour + 1;
                    if hour == 24 {
                        hour = 0;
                    }
                }
            }

            draw_hands(hour, minute, second, false);
        }
    }
}

fn clear_buffer(address: u16, size: u16) -> void {
    while size != 0 {
        store8(address, 0);
        address = address + 1;
        size = size - 1;
    }
}

fn set_color(red: u8, green: u8, blue: u8) -> void {
    color_r = red;
    color_g = green;
    color_b = blue;
}

fn draw_pixel(x: u16, y: u16) -> void {
    let address: u16 = framebuffer + (((y << 7) + x) << 2);
    store8(address, color_r);
    store8(address + 1, color_g);
    store8(address + 2, color_b);
    store8(address + 3, 0);
}

fn draw_line(x0: u16, y0: u16, x1: u16, y1: u16) -> void {
    line_x = x0;
    line_y = y0;
    line_x1 = x1;
    line_y1 = y1;

    if x0 < x1 {
        line_dx = x1 - x0;
        line_sx = 1;
    } else {
        line_dx = x0 - x1;
        line_sx = 0 - 1;
    }

    if y0 < y1 {
        line_dy = 0 - (y1 - y0);
        line_sy = 1;
    } else {
        line_dy = 0 - (y0 - y1);
        line_sy = 0 - 1;
    }

    line_error = line_dx + line_dy;

    loop {
        draw_pixel(line_x, line_y);

        if line_x == line_x1 {
            if line_y == line_y1 {
                return;
            }
        }

        line_error2 = line_error << 1;
        if line_error2 >= line_dy {
            line_error = line_error + line_dy;
            line_x = line_x + line_sx;
        }
        if line_error2 <= line_dx {
            line_error = line_error + line_dx;
            line_y = line_y + line_sy;
        }
    }
}

fn draw_face() -> void {
    let x: u16 = 40;
    let y: u16 = 0;
    let error: u32 = 0 - 39;
    let index: u16 = 0;

    set_color(90, 130, 190);
    while x >= y {
        draw_pixel(CENTER_X + x, CENTER_Y + y);
        draw_pixel(CENTER_X + y, CENTER_Y + x);
        draw_pixel(CENTER_X - y, CENTER_Y + x);
        draw_pixel(CENTER_X - x, CENTER_Y + y);
        draw_pixel(CENTER_X - x, CENTER_Y - y);
        draw_pixel(CENTER_X - y, CENTER_Y - x);
        draw_pixel(CENTER_X + y, CENTER_Y - x);
        draw_pixel(CENTER_X + x, CENTER_Y - y);

        y = y + 1;
        if error < 0 {
            error = error + (y << 1) + 1;
        } else {
            x = x - 1;
            error = error + ((y - x) << 1) + 1;
        }
    }

    set_color(210, 225, 245);
    while index < 12 {
        draw_line(
            load8(tick_inner_x + index),
            load8(tick_inner_y + index),
            load8(tick_outer_x + index),
            load8(tick_outer_y + index)
        );
        index = index + 1;
    }
}

fn draw_hands(hour: u8, minute: u8, second: u8, erase: bool) -> void {
    let clock_hour: u8 = hour;
    let hour_index: u8 = 0;

    if clock_hour >= 12 {
        clock_hour = clock_hour - 12;
    }
    hour_index = (clock_hour << 2) + clock_hour;

    if erase == true {
        set_color(0, 0, 0);
        draw_line(CENTER_X, CENTER_Y, load8(hour_x + hour_index), load8(hour_y + hour_index));
        draw_line(CENTER_X, CENTER_Y, load8(minute_x + minute), load8(minute_y + minute));
        draw_line(CENTER_X, CENTER_Y, load8(second_x + second), load8(second_y + second));
    } else {
        set_color(255, 210, 60);
        draw_line(CENTER_X, CENTER_Y, load8(hour_x + hour_index), load8(hour_y + hour_index));

        set_color(70, 220, 255);
        draw_line(CENTER_X, CENTER_Y, load8(minute_x + minute), load8(minute_y + minute));

        set_color(255, 70, 70);
        draw_line(CENTER_X, CENTER_Y, load8(second_x + second), load8(second_y + second));
    }
}

fn nanoseconds_to_seconds(high: u32, low: u32) -> u32 {
    let quotient: u32 = 0;
    let remainder: u32 = 0;
    let bit: u16 = 64;

    while bit != 0 {
        bit = bit - 1;
        remainder = remainder << 1;

        if bit >= 32 {
            remainder = remainder | ((high >> (bit - 32)) & 1);
        } else {
            remainder = remainder | ((low >> bit) & 1);
        }

        if remainder >= NANOSECONDS_PER_SECOND {
            remainder = remainder - NANOSECONDS_PER_SECOND;
            if bit < 32 {
                quotient = quotient | (1 << bit);
            }
        }
    }

    nanoseconds_remainder = remainder;
    return quotient;
}

fn udiv32(value: u32, divisor: u32) -> u32 {
    let quotient: u32 = 0;
    let remainder: u32 = 0;
    let bit: u16 = 32;

    while bit != 0 {
        bit = bit - 1;
        remainder = (remainder << 1) | ((value >> bit) & 1);
        if remainder >= divisor {
            remainder = remainder - divisor;
            quotient = quotient | (1 << bit);
        }
    }

    division_remainder = remainder;
    return quotient;
}

